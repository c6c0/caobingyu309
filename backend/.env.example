# 姓名：曹炳宇 | 学号：24002120309 |
# 时间：2026-11-20 | 大模型：Claude Opus 6（claude-opus-6）
# 复制本文件为 .env 后填入真实值；.env 已加入 .gitignore，请勿提交真实凭据
DB_USER=your_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_NAME=your_database

# 硅基流动（SiliconFlow）在线客服配置；密钥在 https://cloud.siliconflow.cn/account/ak 获取
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 知识库 RAG：向量模型
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
# 图像识别：视觉模型
SILICONFLOW_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# 七牛云语音识别：模型标识必须全小写（大写会报 no available channels）
QINIU_API_KEY=your_qiniu_api_key
QINIU_ASR_BASE_URL=https://api.qnaigc.com/v1
QINIU_ASR_MODEL=qwen-audio-3.0-asr-flash
# 七牛对话模型（在线客服多平台热切换用）
QINIU_CHAT_BASE_URL=https://api.qnaigc.com/v1
QINIU_CHAT_MODEL=qwen/qwen3.8-flash-next
